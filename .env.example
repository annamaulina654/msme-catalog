# Salin file ini menjadi .env.local lalu isi nilainya.
# Isi juga variabel yang sama di Vercel: Project > Settings > Environment Variables.
#
# PENTING: semua variabel di bawah hanya dipakai di SERVER.
# JANGAN beri awalan NEXT_PUBLIC_ supaya tidak terkirim ke browser.
#
# Lokasi di dashboard Supabase: Project Settings > API (atau API Keys).
# Jika proyekmu masih memakai key lama, pakai "anon" untuk PUBLISHABLE
# dan "service_role" untuk SECRET.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Opsional (fitur bonus), juga hanya dipakai di SERVER:
# Kunci Gemini API untuk deskripsi otomatis (US-14) dan tanya jawab produk (US-50).
# Dapatkan di https://aistudio.google.com/apikey . Tanpa ini, fitur AI menampilkan pesan "belum aktif".
GEMINI_API_KEY=
# Nama model Gemini (bawaan: gemini-2.5-flash).
GEMINI_MODEL=
# Alamat situs untuk sitemap dan Open Graph, misalnya https://nama-tokomu.vercel.app
# (bawaan: alamat produksi Vercel).
SITE_URL=
